rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{productId} {
      // Product documents include private merchandising fields (notably costPriceDzd).
      // Storefront reads are performed by trusted server code and projected to the
      // public Product shape; Firestore rules cannot project individual fields.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /lookCollections/{collectionId} {
      allow read: if resource.data.status == "active";
      allow write: if isAdmin();
    }

    match /looks/{lookId} {
      // Active Look documents also contain a private aggregate cost snapshot.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }


    match /users/{userId}/productFavorites/{productId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Mutations go through /api/favorites so target validation and the
      // favoriteAggregates update remain part of one Admin SDK transaction.
      allow create, update, delete: if false;
    }

    match /users/{userId}/lookFavorites/{lookId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Mutations go through /api/favorites so target validation and the
      // favoriteAggregates update remain part of one Admin SDK transaction.
      allow create, update, delete: if false;
    }

    match /runClubSubmissions/{submissionId} {
      allow read, write: if false;
    }

    match /runClubRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /runClubSubmissionKeys/{keyId} {
      allow read, write: if false;
    }

    match /runClubMonths/{monthKey} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
